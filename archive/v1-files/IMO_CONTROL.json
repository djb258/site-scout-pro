{
  "$schema": "https://imo-creator.dev/schemas/imo-control.json",
  "version": "3.5.0",
  "conformance": {
    "doctrine_version": "3.5.0",
    "ctb_version": "3.5.0",
    "template_source": "imo-creator",
    "upstream_commit": "4237f041a0af3577df602c97646725f0d89f20bd",
    "architecture_ref": "templates/doctrine/ARCHITECTURE.md"
  },
  "sovereign": {
    "id": "barton-family-office",
    "boundary": "Barton Family Office investment systems",
    "cc_layer": "CC-01"
  },
  "hub": {
    "id": "barton-storage",
    "name": "Barton Storage System",
    "purpose": "Self-storage investment analysis and deal screening pipeline",
    "cc_layer": "CC-02",
    "ctb_placement": {
      "trunk": "barton-family-office",
      "branch": "investments",
      "leaf": "storage"
    }
  },
  "lifecycle": {
    "current_phase": "BUILD",
    "phases": ["BOOTSTRAP", "BUILD", "HARDEN", "OPERATE"],
    "bootstrap_date": "2026-01-25",
    "last_sync": "2026-03-14"
  },
  "structure": {
    "required_files": [
      "IMO_CONTROL.json",
      "REGISTRY.yaml",
      "DOCTRINE.md",
      "CLAUDE.md",
      "CC_OPERATIONAL_DIGEST.md",
      "STARTUP_PROTOCOL.md",
      "doctrine/REPO_DOMAIN_SPEC.md"
    ],
    "required_directories": [
      "doctrine",
      "law",
      "src"
    ]
  },
  "ctb_branches": {
    "sys": {
      "path": "src/sys",
      "purpose": "System infrastructure: env loaders, bootstraps, config readers",
      "active": true
    },
    "data": {
      "path": "src/data",
      "purpose": "Data layer: schemas, queries, migrations, repositories",
      "active": true
    },
    "app": {
      "path": "src/app",
      "purpose": "Application logic: modules, services, workflows, business logic",
      "active": true
    },
    "ai": {
      "path": "src/ai",
      "purpose": "AI components: agents, routers, prompts, LLM integrations",
      "active": true
    },
    "ui": {
      "path": "src/ui",
      "purpose": "User interface: pages, components, layouts, styles",
      "active": true
    }
  },
  "forbidden_folders": [
    "utils",
    "helpers",
    "common",
    "shared",
    "lib",
    "misc"
  ],
  "imo": {
    "ingress": {
      "description": "UI forms, API endpoints, webhook receivers",
      "spokes": [
        "ui-dashboard",
        "api-intake"
      ]
    },
    "middle": {
      "description": "Pass pipeline (0-5), scoring engine, decision logic",
      "owns_logic": true,
      "owns_state": true,
      "owns_tools": true
    },
    "egress": {
      "description": "Reports, exports, notifications, Obsidian vault sync",
      "spokes": [
        "obsidian-export",
        "report-generator"
      ]
    }
  },
  "guards": {
    "rate_limits": {
      "api_calls_per_minute": 60,
      "ai_calls_per_minute": 10
    },
    "timeouts": {
      "default_ms": 30000,
      "ai_call_ms": 120000
    }
  },
  "kill_switch": {
    "endpoint": "/api/kill-switch",
    "activation_criteria": [
      "Cost exceeds $100/day",
      "Error rate exceeds 10%",
      "Manual trigger by sovereign"
    ],
    "emergency_contact": "barton-family-office"
  },
  "traceability": {
    "constitution": "BARTON_STORAGE_SYSTEM_CONSTITUTION.md",
    "prd_directory": "docs/prd",
    "adr_directory": "docs/adr"
  },
  "validation": {
    "on_commit": [
      "ctb_structure_check",
      "forbidden_folder_check",
      "import_path_check"
    ],
    "on_pr": [
      "doctrine_conformance_check",
      "compliance_checklist_check"
    ]
  },
  "three_tier_loading": {
    "tier_1_mandatory": [
      "IMO_CONTROL.json",
      "CC_OPERATIONAL_DIGEST.md",
      "CLAUDE.md"
    ],
    "tier_2_on_demand": [
      "DOCTRINE.md",
      "REGISTRY.yaml",
      "doctrine/REPO_DOMAIN_SPEC.md",
      "law/IMO_SYSTEM_SPEC.md"
    ],
    "tier_3_audit_only": [
      "law/AI_EMPLOYEE_OPERATING_CONTRACT.md",
      "law/GUARDSPEC.md",
      "law/ai-employee/AI_EMPLOYEE_PROTOCOL.md"
    ]
  }
}
